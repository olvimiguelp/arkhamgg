{
  "name": "arkham",
  "private": true,
  "version": "1.0.47",
  "type": "module",
  "main": "electron.cjs",
  "productName": "ARKHAM",
  "description": "ARKHAM - aplicación de punto de venta",
  "author": "olvin miguel <olvimiguelp@gmail.com>",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc && vite build",
    "dev:catalogo": "vite --config catalogo-publico/vite.config.ts --host 0.0.0.0 --port 3001",
    "build:catalogo": "npm --prefix catalogo-publico run build",
    "build:catalogo:vercel": "tsc -p catalogo-publico/tsconfig.json && vite build --config catalogo-publico/vite.config.ts --base /catalogo-publico/ --outDir ../dist/catalogo-publico",
    "build:vercel": "npm run build && npm run build:catalogo:vercel",
    "lint": "eslint .",
    "preview": "vite preview",
    "setup:storage": "node scripts/create-storage-buckets.js",
    "sync:config": "node scripts/sync-nombreconfi.js",
    "build:migrations": "powershell -NoProfile -ExecutionPolicy Bypass -File src/scripts/build-all-migrations.ps1",
    "fix:database": "node scripts/fix-database-triggers.js",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:8080 && electron .\"",
    "dist": "npm run build && electron-builder",
    "bot": "node whatsapp-bot/index.js"
  },
  "build": {
    "appId": "com.arkham.app",
    "productName": "ARKHAM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/Windows 10/AppList.targetsize-256.png"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/jspdf": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dotenv": "^16.6.1",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "^6.30.1",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
