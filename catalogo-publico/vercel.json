{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build -- --base /",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/catalogo-publico", "destination": "/index.html" },
    { "source": "/catalogo-publico/", "destination": "/index.html" }
  ]
}
